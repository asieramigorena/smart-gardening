# Template of /etc/smart-gardening/node.env (provision.sh writes the real one).

# AWS IoT Core data endpoint (SSM /smart-gardening/iot/endpoint)
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.eu-south-2.amazonaws.com
# IoT thing name (an entry of var.devices in infra/): device_id and MQTT client ID.
# Topic: smart-gardening/<THING_NAME>/readings (docs/contracts)
THING_NAME=pi-01
# Irrigation zone of the node, sent in every reading (lowercase, see docs/contracts)
ZONE=bed-1

# Optional: certificate paths (default: certs/ next to this file, names as in infra/README.md)
# IOT_CERT=/etc/smart-gardening/certs/pi-01.cert.pem
# IOT_KEY=/etc/smart-gardening/certs/pi-01.private.key
# IOT_ROOT_CA=/etc/smart-gardening/certs/AmazonRootCA1.pem
