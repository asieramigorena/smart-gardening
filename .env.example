# Copy to .env in the repository root:  cp .env.example .env
# .env is git-ignored. Never commit real values.

# --- ML: AEMET OpenData ---
# SECRET: personal API key from https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_KEY=
# Not secret: Bilbao municipality code and Bilbao airport station ID
MUNICIPALITY=48020
STATION=1082

# --- ML: Open-Meteo (public endpoints, not secret) ---
ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
PREVIOUS_RUNS_URL=https://previous-runs-api.open-meteo.com/v1/forecast
FORECAST_URL=https://api.open-meteo.com/v1/forecast

# --- node: Raspberry Pi (optional, not secret) ---
# I2C address of the Grove Base Hat ADC: 0x08 (MM32, default) or 0x04 (STM32)
# GROVE_ADC_ADDRESS=0x08
